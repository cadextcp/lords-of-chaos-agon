# Normalise text to LF in the repo (agondev runs in Linux/WSL; MOS wants LF).
* text=auto eol=lf

*.c    text eol=lf
*.h    text eol=lf
*.asm  text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.csv  text eol=lf
*.yml  text eol=lf
Makefile text eol=lf

*.png  binary
*.aseprite binary
*.bin  binary
*.pdf  binary
